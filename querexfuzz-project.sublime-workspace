								"newText": "# pylint: disable=unused-argument, no-self-use, too-many-public-methods\nfrom lark import Lark, Transformer, v_args\nfrom .grammar import GRAMMAR\n\n\n@v_args(inline=True)\nclass QueryTransformer(Transformer):\n    \"\"\"Transforms the Lark parse tree into a structured dictionary.\"\"\"\n\n    def __init__(self):\n        super().__init__()\n        self.spec = {\n            'select': {'include': [], 'exclude': []}, 'sort': [],\n            'regex': [], 'where': None, 'top': -1, 'flags': [],\n            'dates': [], 'fuzzy': None\n        }\n\n    def empty(self): return self.spec\n    def query(self, clause_list): return self.spec\n    def clause_list(self, *clauses): return self.spec\n\n    # Clauses\n    def top_clause(self, n): self.spec['top'] = int(n)\n    def flags(self, *flags): self.spec['flags'].extend(flags)\n    def regex_clause(self, *items): self.spec['regex'].extend(items)\n    def where_clause(self, _, expr): self.spec['where'] = expr\n    def order_by_clause(self, _, sort_list): self.spec['sort'] = sort_list\n    def date_clause(self, *items): self.spec['dates'].extend(items)\n    def select_clause(self, _, select_list): self.spec['select'] = select_list\n\n    # Clause Components\n    def regexes(self, head, *tail): return [head] + list(tail)\n\n    def regex_bang(self, regex): return (\n        'BANG', regex[1:-1] if regex.startswith('/') else regex)\n\n    def regex_ident(self, ident, regex): return (\n        ident, regex[1:-1] if regex.startswith('/') else regex)\n    def where_clause_list(\n        self, head, *tail): return ' and '.join([head] + list(tail))\n\n    def where_item(self, ident, op, val): return f\"{ident} {op} {val}\"\n    def column_sort_list(self, head, *tail): return [head] + list(tail)\n    def column_sort_asc(self, ident): return (ident, True)\n    def column_sort_desc(self, _, ident): return (ident, False)\n\n    def select_list(self, *items):\n        inc, exc = [], []\n        for item_type, value in items:\n            if item_type == 'include':\n                inc.append(value)\n            elif item_type == 'exclude':\n                exc.append(value)\n            elif item_type == 'all':\n                inc.append('*')\n        return {'include': inc, 'exclude': exc}\n\n    def select_include_identifier(self, ident): return 'include', ident\n    def select_exclude_identifier(self, _, ident): return 'exclude', ident\n    def select_all(self, _): return 'all', '*'\n\n    def date_item(self, *args):\n        field, spec = (args[0], args[1]) if len(args) > 1 else (None, args[0])\n        return {'field': field, **spec}\n\n    def date_specifier(self, *args):\n        unit = args[0]\n        if len(args) == 1:\n            return {'unit': unit, 'start': '0', 'end': None}\n        elif len(args) == 2:\n            return {'unit': unit, 'start': args[1], 'end': '0'}\n        else:\n            return {'unit': unit, 'start': args[1], 'end': args[2]}\n\n    # Terminals\n    def __default_token__(self, token): return token.value\n\n\ndef parser(text: str) -> dict:\n    \"\"\"Parses a querefuzz query string into a specification dictionary.\"\"\"\n    fuzzy_query = None\n    if '#' in text:\n        main_query, fuzzy_query = text.split('#', 1)\n    else:\n        main_query = text.strip()\n\n    lark_parser = Lark(GRAMMAR, start='query', parser='lalr')\n\n    try:\n        tree = lark_parser.parse(main_query)\n        transformer = QueryTransformer()\n        spec = transformer.transform(tree)\n        spec['fuzzy'] = fuzzy_query.strip() if fuzzy_query else None\n        return spec\n    except Exception as e:\n        raise ValueError(f\"Failed to parse query: '{main_query}'. Error: {e}\")\n",
