qq = querexfuzz_from_df(testdf, bang_field='name', recent_field='mod', fuzzy_fields=['bio'])
qq.config


fGT(testdf.q('recent top 3 select name, bio, number, -create, -mod, -accessed # waist myopia ruthless'))


qq.config


